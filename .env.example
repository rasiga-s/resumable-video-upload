# Database connection (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/videodb

# AWS / LocalStack S3 configuration
# AWS_ENDPOINT_URL: Used by the FastAPI backend to interact with S3
AWS_ENDPOINT_URL=http://localhost:4566

# AWS_PUBLIC_ENDPOINT_URL: Used to generate presigned URLs reachable by external clients
AWS_PUBLIC_ENDPOINT_URL=http://localhost:4566

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=videos-bucket

# LocalStack Pro token (required to persist S3 multipart uploads across restarts)
LOCALSTACK_AUTH_TOKEN=your-localstack-auth-token
